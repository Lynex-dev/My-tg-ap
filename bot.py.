users_db = {}

def get_user(user_id):
    if user_id not in users_db:
        users_db[user_id] = {'queries': 5, 'promocodes': []}
    return users_db[user_id]

@bot.message_handler(commands=['start'])
def start_cmd(message):
    user_id = message.from_user.id
    get_user(user_id)
    
    markup = telebot.types.InlineKeyboardMarkup()
    web_app = telebot.types.WebAppInfo(url=WEBAPP_URL)
    markup.add(telebot.types.InlineKeyboardButton(text="Открыть Поиск", web_app=web_app))
    
    bot.send_message(message.chat.id, "Привет! Нажми кнопку ниже, чтобы открыть приложение.", reply_markup=markup)

@bot.pre_checkout_query_handler(func=lambda query: True)
def checkout(pre_checkout_query):
    bot.answer_pre_checkout_query(pre_checkout_query.id, ok=True)

@bot.message_handler(content_types=['successful_payment'])
def got_payment(message):
    user_id = message.from_user.id
    user = get_user(user_id)
    user['queries'] += 5
    bot.send_message(message.chat.id, f"✅ Оплата прошла успешно!\nВам зачислено 5 запросов.\nТеперь у вас: {user['queries']} запросов.")

@app.route('/api/balance', methods=['GET'])
def get_balance():
    user_id = int(request.args.get('user_id'))
    user = get_user(user_id)
    return jsonify({'queries': user['queries']})

@app.route('/api/buy', methods=['POST'])
def buy_queries():
    data = request.json
    user_id = int(data['user_id'])
    prices = [LabeledPrice(label='5 запросов', amount=50)]
    
    try:
        invoice_link = bot.create_invoice_link(
            title="Покупка запросов",
            description="5 запросов для поиска и рулетки",
            payload="buy_5_queries",
            provider_token="",
            currency="XTR",
            prices=prices
        )
        return jsonify({'invoice_link': invoice_link})
    except Exception as e:
        return jsonify({'error': str(e)}), 400

def run_bot():
    bot.infinity_polling()

if __name__ == '__main__':
